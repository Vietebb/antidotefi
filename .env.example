# ==============================================================================
# ANTIDOTE QUANT TERMINAL — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# Never commit actual secret values to git history.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Backend & Database
# ------------------------------------------------------------------------------
# Public project URL (Client + Server safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (Client safe under strict RLS policies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# Private service role key (Server-only — NEVER expose to browser client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SERVICE_ROLE_SECRET=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# Telegram Bot Integration
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather (Server-only)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Bot Public URL & Handle (e.g., https://t.me/YourBotName)
TELEGRAM_BOT_URL=https://t.me/your_telegram_bot_handle
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/your_telegram_bot_handle

# Optional comma-separated Telegram Chat IDs for broadcast alerts
TELEGRAM_CHAT_IDS=123456789,987654321

# ------------------------------------------------------------------------------
# Google Gemini AI API
# ------------------------------------------------------------------------------
# Google AI Studio / Gemini API Key for sentiment scoring & RAG embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ------------------------------------------------------------------------------
# Application Base URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_VERCEL_URL=https://your-production-app.vercel.app

# ------------------------------------------------------------------------------
# Market & RSS Feeds (Optional custom endpoints)
# ------------------------------------------------------------------------------
BINANCE_API_URL=https://api.binance.com/api/v3/ticker/24hr
REDDIT_RSS_URL=https://www.reddit.com/r/CryptoCurrency/top/.rss?t=hour
COINDESK_RSS_URL=https://www.coindesk.com/arc/outboundfeeds/rss/

